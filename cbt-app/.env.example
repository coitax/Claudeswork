# Copy to .env and adjust. Used by the API (apps/api).

# --- Server ---
HOST=127.0.0.1
PORT=5174
# NODE_ENV=production   # set when serving the built SPA from the API

# --- Storage ---
# Where JSON data is stored. Defaults to <repo>/cbt-app/data.
# DATA_DIR=/absolute/path/to/data
# Only "file" is implemented in v1. "sqlite" is a future stub.
STORAGE_DRIVER=file

# --- Sessions ---
# Session lifetime in hours (default 168 = 7 days).
SESSION_TTL_HOURS=168

# --- Login rate limiting ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# --- Seeding the single user (optional; otherwise `pnpm seed` prompts) ---
# CBT_USERNAME=me
# CBT_EMAIL=me@example.com
# CBT_PASSWORD=change-me
# CBT_FORCE=1   # overwrite an existing user's credentials
