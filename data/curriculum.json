              { "sentence": "Uno, dos, ___, cuatro.", "answer": "tres", "distractors": ["cinco", "seis", "diez"], "hint": "Counting in order", "feedback": "After dos (2) comes tres (3)." },
              { "sentence": "Diez más diez son ___.", "answer": "veinte", "distractors": ["once", "quince", "treinta"], "hint": "10 + 10 = ?", "feedback": "10 + 10 = 20 = veinte." }
            ] }
