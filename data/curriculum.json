            { "type": "fill-blank", "sentences": [
              { "sentence": "___ días, profesor.", "answer": "Buenos", "distractors": ["Buenas", "Hola", "Gracias"], "hint": "Good morning", "feedback": "'Buenos días' is masculine — días is masculine plural." },
              { "sentence": "—Gracias. —De ___.", "answer": "nada", "distractors": ["sí", "no", "adiós"], "hint": "You're welcome", "feedback": "'De nada' literally means 'of nothing' — the standard response to gracias." }
            ] },
            { "type": "dialogue", "scene": "meeting-stranger" },
            { "type": "translate", "items": [
              { "direction": "en-es", "source": "Hello, how are you?", "answer": "Hola cómo estás", "words": ["Hola", "cómo", "estás", "adiós", "bien", "gracias"] },
              { "direction": "es-en", "source": "Buenos días, gracias.", "answer": "Good morning thank you", "words": ["Good", "morning", "thank", "you", "night", "afternoon"] }
            ] }
          ]
        },
        {
          "id": "plaza-2",
          "name": "Me llamo...",
          "description": "Introducing yourself",
