            { "type": "match", "words": ["me_llamo", "soy", "yo", "tú", "él", "ella"] },
            { "type": "fill-blank", "sentences": [
              { "sentence": "Me ___ Carlos.", "answer": "llamo", "distractors": ["soy", "tengo", "estoy"], "hint": "My name is", "feedback": "'Me llamo' literally means 'I call myself.'" },
              { "sentence": "Mucho ___.", "answer": "gusto", "distractors": ["bien", "gracias", "favor"], "hint": "Nice to meet you", "feedback": "'Mucho gusto' = 'much pleasure' = nice to meet you." }
            ] },
            { "type": "translate", "items": [
              { "direction": "en-es", "source": "I am Ana", "answer": "Yo soy Ana", "words": ["Yo", "soy", "Ana", "tú", "es", "ella"] }
